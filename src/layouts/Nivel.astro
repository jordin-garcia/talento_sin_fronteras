---
// Plantilla común de los niveles (R-2.1 … R-2.7).
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Video from '../components/Video.astro';
import VersionTexto from '../components/VersionTexto.astro';
import Globo from '../components/Globo.astro';
import { NIVELES, GUIAS } from '../data/sitio';
import { img, DIORAMA_NIVEL, ICONO_NIVEL } from '../data/imagenes';
import { url } from '../scripts/ruta';

interface Props { n: number; saludo: string; poseGuia?: 'saludo' | 'senala' | 'celular' | 'celebra' }
const { n, saludo, poseGuia = 'senala' } = Astro.props;
const nivel = NIVELES.find((x) => x.n === n)!;
const anterior = NIVELES.find((x) => x.n === n - 1);
const siguiente = NIVELES.find((x) => x.n === n + 1);
const guia = nivel.guia === 'nina' ? 'ixchel' : 'balam';
const nombreGuia = GUIAS[nivel.guia].nombre;
const pasos = ['Total', 'Parcial', 'Parcial', 'Mínimo', 'Nulo'];
---

<Base titulo={`Nivel ${n}: ${nivel.titulo}`} descripcion={nivel.resumen}>
  <div class="nivel" style={`--brillo:${nivel.brillo}`}>
    <header class="cabecera">
      <div class="contenedor cab-grid">
        <div class="cab-texto">
          <a class="volver" href={url('/#camino')}>‹ Volver al mapa</a>
          <p class="num"><Image src={img(ICONO_NIVEL[n])} alt="" width={44} /> Nivel {n} de 5 · {nivel.modulo}</p>
          <h1>{nivel.titulo}</h1>
          <p class="resumen">{nivel.resumen}</p>
          <ul class="datos">
            <li class="chip">⏱ {nivel.minutos} minutos</li>
            <li class="chip">🧭 Apoyo: {nivel.apoyo}</li>
          </ul>
          <ol class="andamio" aria-label="Nivel de apoyo a lo largo de la ruta">
            {pasos.map((p, i) => <li class:list={{ activo: i + 1 === n }} title={`Nivel ${i + 1}: apoyo ${p}`}><span style={`--h:${100 - i * 20}%`}></span></li>)}
          </ol>
        </div>
        <div class="cab-arte" aria-hidden="true">
          <span class="halo"></span>
          <Image src={img(DIORAMA_NIVEL[n])} alt="" widths={[320, 520]} sizes="(min-width: 900px) 460px, 78vw" class="dio flotar" loading="eager" />
        </div>
      </div>
    </header>

    <div class="contenedor cuerpo">
      <Globo guia={guia} pose={poseGuia} nombre={nombreGuia}>{saludo}</Globo>

      <div class="cinta" role="note">
        <span>🔒 <b>Nunca comparta</b> datos personales</span>
        <span>🔍 <b>Siempre verifique</b> lo que diga la IA</span>
      </div>

      <section class="bloque" aria-labelledby="video-titulo">
        <h2 id="video-titulo"><span class="paso">1</span> Vea el video</h2>
        <Video id={nivel.youtubeId} titulo={nivel.tituloVideo} />
        <p class="alt-texto">¿Prefiere no gastar datos? <a href="#version-texto">Lea la versión en texto ↓</a></p>
      </section>

      <section class="bloque" aria-labelledby="practica-titulo">
        <h2 id="practica-titulo"><span class="paso">2</span> Aprenda y practique</h2>
        <slot />
      </section>

      <section class="bloque" id="version-texto" aria-labelledby="texto-titulo">
        <h2 id="texto-titulo"><span class="paso">3</span> Versión en texto del video</h2>
        <VersionTexto video={nivel.video} />
      </section>

      <section class="bloque completar" aria-labelledby="completar-titulo" data-completar={n}>
        <h2 id="completar-titulo" class="sr-only">Completar el nivel</h2>
        <div class="completar-caja">
          <Image src={img(`${guia}-celebra`)} alt="" width={180} class="cel-guia" />
          <div>
            <p class="c-titulo">¿Terminó este nivel?</p>
            <p class="c-sub">Su teléfono recordará su avance. No se guarda nada más.</p>
            <button class="boton verde" type="button" data-boton-completar>
              <span class="no-hecho">✔ Completé este nivel</span>
              <span class="si-hecho">★ ¡Nivel completado!</span>
            </button>
            <div class="despues" hidden>
              {siguiente
                ? <a class="boton" href={url(siguiente.slug)}>Ir al nivel {siguiente.n}: {siguiente.titulo} ›</a>
                : <a class="boton" href={url('/morral')}>Abrir mi morral de herramientas ›</a>}
            </div>
          </div>
        </div>
      </section>

      <nav class="nav-niveles" aria-label="Navegación entre niveles">
        {anterior ? <a href={url(anterior.slug)} class="boton secundario chico">‹ Nivel {anterior.n}</a> : <span></span>}
        <a href={url('/#mapa')} class="boton-texto">🗺️ Mapa</a>
        {siguiente ? <a href={url(siguiente.slug)} class="boton secundario chico">Nivel {siguiente.n} ›</a> : <a href={url('/morral')} class="boton secundario chico">Morral ›</a>}
      </nav>
    </div>
  </div>
</Base>

<script>
  import { completado, completar } from '../scripts/progreso';
  import { confeti } from '../scripts/utilidades';
  import { revelar } from '../scripts/animaciones-nivel';
  revelar();
  const caja = document.querySelector<HTMLElement>('[data-completar]');
  if (caja) {
    const n = Number(caja.dataset.completar);
    const boton = caja.querySelector<HTMLButtonElement>('[data-boton-completar]')!;
    const despues = caja.querySelector<HTMLElement>('.despues')!;
    const marcar = () => { caja.classList.add('hecho'); despues.hidden = false; };
    if (completado(n)) marcar();
    boton.addEventListener('click', () => {
      completar(n);
      marcar();
      confeti();
    });
  }
</script>

<style>
  .nivel { padding-top: 72px; }
  .cabecera { position: relative; padding: 24px 0 10px; overflow: hidden; }
  .cabecera::before {
    content: ''; position: absolute; inset: 0; z-index: -1;
    background: radial-gradient(ellipse at 75% 40%, color-mix(in srgb, var(--brillo) 38%, transparent), transparent 60%);
  }
  .cab-grid { display: grid; gap: 8px; align-items: center; }
  @media (min-width: 860px) { .cab-grid { grid-template-columns: 1.1fr 0.9fr; } }
  .volver { display: inline-flex; align-items: center; min-height: 44px; font-weight: 800; color: var(--texto-suave); text-decoration: none; }
  .num { display: flex; align-items: center; gap: 8px; margin: 4px 0 6px; font-family: var(--fuente-titulo); font-weight: 800; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in srgb, var(--brillo) 60%, white); }
  .num :global(img) { width: 40px; }
  h1 { font-size: clamp(2.2rem, 10vw, 3.6rem); font-weight: 800; text-shadow: 0 0 30px color-mix(in srgb, var(--brillo) 55%, transparent); }
  .resumen { font-size: 1.12rem; color: #e6e2ff; font-weight: 600; }
  .datos { list-style: none; padding: 0; margin: 0 0 14px; display: flex; flex-wrap: wrap; gap: 8px; }
  .andamio { list-style: none; padding: 0; margin: 0; display: flex; gap: 6px; align-items: flex-end; height: 34px; }
  .andamio li { width: 26px; height: 100%; display: flex; align-items: flex-end; }
  .andamio span { display: block; width: 100%; height: var(--h); min-height: 5px; border-radius: 6px; background: rgba(255,255,255,.18); }
  .andamio .activo span { background: var(--brillo); box-shadow: 0 0 12px var(--brillo); }
  .cab-arte { position: relative; width: min(78vw, 460px); margin: 0 auto; }
  .cab-arte .halo { position: absolute; inset: 10%; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--brillo) 70%, transparent), transparent 70%); filter: blur(18px); }
  .cab-arte :global(.dio) { position: relative; width: 100%; filter: drop-shadow(0 22px 26px rgba(0,0,0,.55)); }

  .cuerpo { display: grid; gap: 22px; padding-bottom: 40px; }
  .cinta {
    display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 18px; padding: 10px 14px; border-radius: 16px;
    background: linear-gradient(90deg, rgba(255, 93, 115, 0.18), rgba(58, 208, 138, 0.18)); border: 1px solid var(--borde); font-size: 0.98rem;
  }
  .bloque { scroll-margin-top: 80px; }
  .bloque > h2 { display: flex; align-items: center; gap: 12px; font-size: clamp(1.45rem, 6vw, 2rem); }
  .paso {
    flex: none; width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; font-size: 1.2rem;
    color: #160f33; background: var(--brillo); box-shadow: 0 0 18px color-mix(in srgb, var(--brillo) 70%, transparent);
  }
  .alt-texto { margin: 10px 0 0; color: var(--texto-suave); }
  .alt-texto a { color: var(--como); font-weight: 800; }

  .completar-caja {
    display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: center; padding: 22px 18px; border-radius: 26px;
    background: linear-gradient(150deg, rgba(58, 208, 138, 0.22), rgba(20, 24, 84, 0.8)); border: 2px solid rgba(58, 208, 138, 0.45);
  }
  .completar-caja :global(.cel-guia) { width: clamp(90px, 26vw, 160px); filter: drop-shadow(0 10px 14px rgba(0,0,0,.4)); }
  .c-titulo { font-family: var(--fuente-titulo); font-weight: 800; font-size: 1.45rem; margin: 0; }
  .c-sub { color: var(--texto-suave); font-size: 0.95rem; }
  .si-hecho { display: none; }
  .hecho .si-hecho { display: inline; }
  .hecho .no-hecho { display: none; }
  .despues { margin-top: 14px; }
  .despues .boton { white-space: normal; text-align: center; }
  .nav-niveles { display: flex; justify-content: space-between; align-items: center; gap: 10px; }
</style>
