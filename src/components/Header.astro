---
import { SITIO } from '../data/sitio';
import { url } from '../scripts/ruta';
const { inicio = false } = Astro.props;
---

<header class="barra">
  <div class="barra-interior">
    <a class="marca" href={url('/')} aria-label={`${SITIO.nombre}, ir al inicio`}>
      <img src={url('/logo.svg')} alt="" width="40" height="40" />
      <span>Talento <b>Sin Fronteras</b></span>
    </a>
    <a class="avance" href={url('/#mapa')} aria-label="Mi avance en la ruta">
      <span class="estrella" aria-hidden="true">★</span>
      <span><b data-progreso-cuenta>0</b>/5</span>
      <span class="barrita" aria-hidden="true"><i data-progreso-barra></i></span>
    </a>
  </div>
</header>

<style>
  .barra {
    position: fixed; inset: 0 0 auto 0; z-index: 50;
    padding: max(8px, env(safe-area-inset-top)) 0 8px;
    background: linear-gradient(180deg, rgba(10, 12, 42, 0.85), rgba(10, 12, 42, 0.45));
    backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .barra-interior { width: min(1120px, 100% - 24px); margin-inline: auto; display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .marca { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--fuente-titulo); font-weight: 700; font-size: 1.12rem; line-height: 1; }
  .marca img { width: 40px; height: 40px; filter: drop-shadow(0 0 10px rgba(176, 107, 255, 0.6)); }
  .marca b { color: var(--como); font-weight: 800; }
  .avance {
    display: flex; align-items: center; gap: 8px; text-decoration: none; min-height: 44px;
    padding: 6px 12px; border-radius: 999px; background: rgba(255, 255, 255, 0.08); border: 1px solid var(--borde);
    font-family: var(--fuente-titulo); font-weight: 700;
  }
  .estrella { color: var(--oro); text-shadow: 0 0 10px rgba(255, 200, 70, 0.9); }
  .barrita { width: 46px; height: 7px; border-radius: 99px; background: rgba(255, 255, 255, 0.15); overflow: hidden; }
  .barrita i { display: block; height: 100%; width: calc(var(--avance, 0) * 100%); background: linear-gradient(90deg, var(--quien), var(--que), var(--como)); transition: width 0.6s; }
  @media (max-width: 359px) { .marca span { display: none; } }
</style>
