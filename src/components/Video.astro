---
// Video de YouTube en modo oculto con fachada (R-2.2, R-2.3, R-10.3):
// no se contacta a YouTube hasta que la persona toca "Ver video".
interface Props { id: string; titulo: string }
const { id, titulo } = Astro.props;
---

{id ? (
  <div class="video" data-video={id}>
    <button type="button" class="fachada" aria-label={`Ver el video: ${titulo}`}>
      <span class="play" aria-hidden="true">▶</span>
      <span class="v-titulo">{titulo}</span>
      <span class="v-nota">Al tocar, el video se carga desde YouTube y usa datos móviles.</span>
    </button>
  </div>
) : (
  <div class="video pendiente">
    <div class="pend-interior">
      <span class="icono" aria-hidden="true">🎬</span>
      <p class="v-titulo">{titulo}</p>
      <p class="v-nota">Video en preparación. Mientras tanto, lea la versión en texto: dice exactamente lo mismo.</p>
      <a class="boton chico" href="#version-texto">Leer la versión en texto</a>
    </div>
  </div>
)}

<style>
  .video {
    position: relative; aspect-ratio: 16 / 9; border-radius: 22px; overflow: hidden;
    background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--brillo, #7a5cff) 45%, #141a55), #0b0e33 75%);
    border: 2px solid color-mix(in srgb, var(--brillo, #7a5cff) 50%, transparent); box-shadow: var(--sombra);
  }
  .fachada { all: unset; cursor: pointer; position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 16px; }
  .fachada:focus-visible { outline: 3px solid var(--oro); outline-offset: -6px; }
  .play {
    width: 78px; height: 78px; border-radius: 50%; display: grid; place-items: center; font-size: 2rem; padding-left: 6px;
    color: #3a1d00; background: linear-gradient(180deg, #ffd56b, #ffab2e); box-shadow: 0 0 0 10px rgba(255, 200, 80, 0.2), 0 12px 30px rgba(0,0,0,.5);
    animation: latido 2s ease-in-out infinite;
  }
  @keyframes latido { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.08); } }
  .v-titulo { font-family: var(--fuente-titulo); font-weight: 800; font-size: clamp(1.05rem, 4.4vw, 1.4rem); margin: 0; }
  .v-nota { font-size: 0.86rem; color: var(--texto-suave); margin: 0; max-width: 30em; }
  .pendiente { aspect-ratio: auto; min-height: 220px; display: grid; place-items: center; }
  .pend-interior { padding: 22px 18px; text-align: center; display: grid; gap: 8px; justify-items: center; }
  .icono { font-size: 2.6rem; }
  .video :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-video]').forEach((v) => {
    v.querySelector('button')?.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(v.dataset.video!)}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
      f.title = 'Video de la ruta de aprendizaje';
      f.allow = 'accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      f.referrerPolicy = 'strict-origin-when-cross-origin';
      v.replaceChildren(f);
    });
  });
</script>
